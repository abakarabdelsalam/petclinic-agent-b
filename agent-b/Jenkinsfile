// Pipeline de non-régression : une PR sur petclinic-rest déclenche l'agent, qui commente la PR.
// Agent Jenkins Windows avec Node 24, Java, Maven, git et gh.
pipeline {
  agent { label 'windows' }

  parameters {
    string(name: 'PETCLINIC_URL', defaultValue: 'https://github.com/spring-petclinic/spring-petclinic-rest.git')
    string(name: 'PR_BRANCH', description: 'Branche de la PR à tester')
    string(name: 'BASE_BRANCH', defaultValue: 'master')
    string(name: 'PR_NUMBER', defaultValue: '', description: 'Numéro de PR GitHub, pour le commentaire')
  }

  environment {
    CLAUDE_MODE = 'real'
    DIFF_BASE = "origin/${params.BASE_BRANCH}"
  }

  options { timeout(time: 30, unit: 'MINUTES') }

  stages {
    stage('Récupérer la PR') {
      steps {
        dir('petclinic-rest') {
          git url: params.PETCLINIC_URL, branch: params.PR_BRANCH
          bat "git fetch origin ${params.BASE_BRANCH}"
        }
        dir('petclinic-angular') {
          git url: 'https://github.com/spring-petclinic/spring-petclinic-angular.git', branch: 'master'
        }
      }
    }

    stage('Installer') {
      steps {
        bat 'cd mcp-server && npm ci && npx playwright install chromium'
        bat 'cd agent-b && npm ci'
        bat 'cd petclinic-angular && npm ci'
        bat 'cd petclinic-rest && mvn -q -DskipTests compile'
      }
    }

    stage('Lancer le front') {
      steps {
        bat 'start /B cmd /c "cd petclinic-angular && npx ng serve --port 4300 > ..\\front.log 2>&1"'
      }
    }

    stage('Tester la PR') {
      steps {
        withCredentials([string(credentialsId: 'anthropic-api-key', variable: 'ANTHROPIC_API_KEY')]) {
          script {
            // 0 = aucune régression, 1 = régression confirmée, 2 = panne de l'agent.
            def code
            withEnv(["PETCLINIC_REPO=${env.WORKSPACE}\\petclinic-rest"]) {
              code = bat(returnStatus: true, script: 'node agent-b\\run-pr.js')
            }
            if (code == 1) { unstable('Régression confirmée par l\'agent') }
            else if (code != 0) { error('L\'agent a échoué') }
          }
        }
      }
    }

    stage('Commenter la PR') {
      when { expression { params.PR_NUMBER?.trim() } }
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
          bat "gh pr comment ${params.PR_NUMBER} --repo ${params.PETCLINIC_URL} --body-file agent-b\\resultats\\commentaire-pr.md"
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'agent-b/resultats/*, mcp-server/captures/*, front.log', allowEmptyArchive: true
      bat(returnStatus: true, script: 'for /f "tokens=5" %%p in (\'netstat -ano ^| findstr ":9966 :4300" ^| findstr LISTENING\') do taskkill /PID %%p /T /F')
    }
  }
}
